<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}My Website{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background: #212939;
            color: white;
        }

        .navbar {
            background: linear-gradient(135deg, #1a1f24, #2b2f33);
            box-shadow: 0 0 20px rgba(255, 140, 0, 0.8);
            border-bottom: 2px solid rgba(255, 140, 0, 0.8);
        }

        .navbar-brand, .nav-link {
            color: white !important;
            font-weight: bold;
            transition: color 0.3s ease;
        }

        .navbar-brand:hover, .nav-link:hover {
            color: rgba(255, 140, 0, 0.8) !important;
        }

        .navbar-toggler {
            border: none;
            color: rgba(255, 140, 0, 0.8);
        }

        .dropdown-menu {
            background: #1a1f24;
            color: white !important;
            border: 1px solid rgba(255, 140, 0, 0.8);
        }
        .dropdown-item{
            color: white !important;
        }

        .dropdown-item:hover {
            background: rgba(255, 140, 0, 0.8);
            color: #1a1f24 !important;
        }

        /* Footer Styling */
        footer {
            background: #1a1f24;
            color: white;
            padding: 40px 0;
            border-top: 2px solid rgba(255, 140, 0, 0.8);
        }

        footer a {
            color: rgba(255, 140, 0, 0.8);
            text-decoration: none;
        }

        footer a:hover {
            text-decoration: underline;
        }

        footer .social-icons a {
            font-size: 24px;
            margin: 0 10px;
            color: rgba(255, 140, 0, 0.8);
        }

        footer .social-icons a:hover {
            color: white;
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand" href="{{ path('app_home') }}">
                <i class="fas fa-moon"></i> ImmoFuture
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">

                    <!-- Dropdown Immobilier -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="immobilierDropdown" role="button" data-bs-toggle="dropdown">
                            <i class="fas fa-building"></i> Immobilier
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="{{ path('app_immobilier_index') }}">Hub</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_immobilierGet_new') }}">Ajouter un Bien</a></li>
                        </ul>
                    </li>

                    <!-- Dropdown Réservations -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="reservationDropdown" role="button" data-bs-toggle="dropdown">
                            <i class="fas fa-calendar-alt"></i> Réservations
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="{{ path('app_reservation_index') }}">Hub</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_reservation_get_new') }}">Nouvelle Réservation</a></li>
                        </ul>
                    </li>

                    <!-- Dropdown Réclamations (admin seulement) -->
                    {% if is_granted('ROLE_ADMIN') %}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="reclamationDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-list-alt"></i> Réclamations
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="{{ path('app_reclamation_index') }}">Hub</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_reclamation_new') }}">Nouvelle Réclamation</a></li>
                            </ul>
                        </li>
                    {% endif %}

                    <!-- Gestion Utilisateur -->
                    {% if app.user %}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                <img src="{{ asset('images/' ~ app.user.profilePicture) }}" alt="User Icon" class="rounded-circle me-2" width="30" height="30">
                                {{ app.user.firstName }}
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="{{ path('app_profile') }}">Mon Profil</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_logout') }}"><i class="fas fa-sign-out-alt"></i> Se Déconnecter</a></li>
                            </ul>
                        </li>
                    {% else %}
                        <li class="nav-item"><a class="nav-link" href="{{ path('app_login') }}">Se Connecter</a></li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>
</header>


<main class="py-5 mt-4">
    {% block body %}{% endblock %}
</main>

<!-- Footer Section -->
<footer class="text-center">
    <div class="container">
        <p>&copy; 2024 ImmoFuture. Tous droits réservés.</p>
        <p>
            <a href="{{ path('app_home') }}">Accueil</a> |
            <a >Contact</a> |
            <a >Mentions Légales</a>
        </p>
        <div class="social-icons mt-3">
            <a href="https://facebook.com" target="_blank"><i class="fab fa-facebook"></i></a>
            <a href="https://instagram.com" target="_blank"><i class="fab fa-instagram"></i></a>
            <a href="https://linkedin.com" target="_blank"><i class="fab fa-linkedin"></i></a>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
