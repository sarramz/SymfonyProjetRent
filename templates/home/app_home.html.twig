{% extends 'base.html.twig' %}

{% block title %}Bienvenue sur SBRLocations - Location en Tunisie{% endblock %}

{% block body %}

    <!-- Hero Section -->
    <section class="hero-section position-relative text-center text-light d-flex align-items-center justify-content-center" style="height: 100vh;">
        <div class="hero-bg" style="
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: url('{{ asset('images/hero.jpg') }}') no-repeat center center/cover;
                z-index: 1;
                ">
        </div>
        <div class="hero-overlay" style="
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
        z-index: 2;">
        </div>

        <!-- Hero Content -->
        <div class="hero-content position-relative" style="z-index: 3;">
            <h1 class="display-2 fw-bold">Bienvenue sur SBRLocations</h1>
            <p class="lead">La plateforme de location numéro 1 en Tunisie.</p>
            <a href="#services" class="btn btn-lg btn-outline-light mt-4">Découvrir Nos Services</a>
        </div>
    </section>


    <!-- Services Section -->
    <section id="services" class="py-5 text-center">
        <div class="container">
            <h2 class="text-orange fw-bold mb-5">Nos Services</h2>
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <i class="fas fa-home fa-4x text-orange mb-3"></i>
                    <h4>Location Immobilière</h4>
                    <p>Découvrez une large gamme de biens immobiliers à louer, allant des appartements modernes aux villas luxueuses, partout en Tunisie.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Team Section -->
    <section id="team" class="py-5 bg-dark text-light text-center">
        <div class="container">
            <h2 class="text-orange fw-bold mb-5">Rencontrez Notre Équipe</h2>
            <div class="row">
                <div class="col-md-4">
                    <img src="{{ asset('images/team1.jpg') }}" class="rounded-circle mb-3" width="150" height="150" alt="Membre 1">
                    <h5>Ahmed Ben Ali</h5>
                    <p>Responsable Immobilier</p>
                </div>
                <div class="col-md-4">
                    <img src="{{ asset('images/team2.jpg') }}" class="rounded-circle mb-3" width="150" height="150" alt="Membre 2">
                    <h5>Sarah Gharbi</h5>
                    <p>Gestionnaire de Flotte</p>
                </div>
                <div class="col-md-4">
                    <img src="{{ asset('images/team3.jpg') }}" class="rounded-circle mb-3" width="150" height="150" alt="Membre 3">
                    <h5>Mohamed Trabelsi</h5>
                    <p>Service Client</p>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
