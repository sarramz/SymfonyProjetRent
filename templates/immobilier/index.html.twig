{% extends 'base.html.twig' %}

{% block title %}Liste des biens immobiliers{% endblock %}

{% block body %}
    <div class="container my-5">
        <h1 class="text-center mb-5 fw-bold">Découvrez Nos Annonces</h1>
        <form method="get" action="{{ path('app_immobilier_index') }}" class="mb-4">
            <div class="row g-3">
                <div class="col-md-4">
                    <input type="text" name="ville" class="form-control" placeholder="Ville" value="{{ app.request.get('ville') }}">
                </div>
                <div class="col-md-4">
                    <input type="number" name="prix_min" class="form-control" placeholder="Prix Min" value="{{ app.request.get('prix_min') }}">
                </div>
                <div class="col-md-4">
                    <input type="number" name="prix_max" class="form-control" placeholder="Prix Max" value="{{ app.request.get('prix_max') }}">
                </div>
            </div>
            <button type="submit" class="btn btn-primary mt-3">Filtrer</button>
        </form>

        {% if immobiliers|length > 0 %}
            <div class="row g-4">
                {% for immobilier in immobiliers %}
                    <div class="col-md-6 col-lg-4">
                        <a href="{{ path('app_immobilier_show', {'id': immobilier.id}) }}" class="card-link text-decoration-none">
                            <div class="card border-0 shadow-lg h-100 rounded-3 overflow-hidden">
                                <div class="position-relative">
                                    <img src="{{ asset('images/defaultCover.jpg') }}"
                                         class="card-img-top" alt="Image de l'immobilier" style="height: 200px; object-fit: cover;">
                                    <span class="badge position-absolute top-0 start-0 m-3 shadow-sm rounded-pill px-3 py-2">
                                        {{ immobilier.prix }} DT
                                    </span>
                                </div>
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title text-truncate fw-bold text-secondary">{{ immobilier.description }}</h5>
                                    <p class="card-text text-muted small">
                                        <i class="fas fa-map-marker-alt text-danger"></i> {{ immobilier.adresse }}, {{ immobilier.ville }}
                                    </p>
                                </div>
                            </div>
                        </a>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="alert alert-info text-center">
                <p class="fs-5">Aucun bien immobilier disponible pour le moment. Revenez plus tard !</p>
            </div>
        {% endif %}
    </div>

    <style>
        body {
            background-color: #f8f9fa;
            color: #333;
            font-family: 'Roboto', sans-serif;
        }

        .card-link {
            text-decoration: none;
            color: inherit;
        }

        .card {
            transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
            cursor: pointer;
        }

        .card:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        .badge {
            font-size: 1rem;
            padding: 0.6em 1em;
            background-color: rgba(255, 140, 0, 0.8);
            font-weight: bold;
            border-radius: 30px;
        }

        .card-img-top {
            transition: transform 0.3s ease;
        }

        .card:hover .card-img-top {
            transform: scale(1.1);
        }

        .card-body {
            padding: 1.5rem;
            background-color: #fff;
        }
    </style>
{% endblock %}
