{% extends 'base.html.twig' %}

{% block title %}Détails de la Réclamation{% endblock %}

{% block body %}
    <div class="reclamation-detail">
        <div class="reclamation-card">
            <h1 class="reclamation-title">Réclamation #{{ reclamation.id }}</h1>

            <div class="reclamation-content">
                <div class="reclamation-info">
                    <h2>Contenu de la Réclamation</h2>
                    <p>{{ reclamation.contenu }}</p>
                </div>

                <div class="reclamation-meta">
                    <div class="meta-item">
                        <i class="fas fa-calendar-alt"></i>
                        <span>Date de Création: {{ reclamation.date ? reclamation.date|date('d/m/Y') : 'Non précisée' }}</span>
                    </div>
                    <!-- Add more meta information here if needed -->
                </div>
            </div>

            <div class="reclamation-actions">
                <a href="{{ path('app_reclamation_index') }}" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Retour à la liste
                </a>
                <a href="{{ path('app_reclamation_edit', {'id': reclamation.id}) }}" class="btn btn-primary">
                    <i class="fas fa-edit"></i> Modifier
                </a>
            </div>

            <div class="reclamation-delete">
                {{ include('reclamation/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        body {
            background-color: #f8f9fa;
            color: #333;
            font-family: 'Roboto', sans-serif;
        }
        .reclamation-detail {
            max-width: 800px;
            margin: 2rem auto;
            padding: 0 1rem;
        }

        .reclamation-card {
            background-color: #ffffff;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            padding: 2rem;
        }

        .reclamation-title {
            font-size: 2rem;
            color: #333;
            text-align: center;
            margin-bottom: 1.5rem;
            border-bottom: 2px solid #f0f0f0;
            padding-bottom: 1rem;
        }

        .reclamation-content {
            margin-bottom: 2rem;
        }

        .reclamation-info h2 {
            font-size: 1.25rem;
            color: #555;
            margin-bottom: 0.5rem;
        }

        .reclamation-info p {
            font-size: 1rem;
            color: #333;
            line-height: 1.6;
            background-color: #f9f9f9;
            padding: 1rem;
            border-radius: 4px;
            border-left: 4px solid #007bff;
        }

        .reclamation-meta {
            margin-top: 1.5rem;
        }

        .meta-item {
            display: flex;
            align-items: center;
            margin-bottom: 0.5rem;
            font-size: 0.9rem;
            color: #666;
        }

        .meta-item i {
            margin-right: 0.5rem;
            color: #007bff;
        }

        .reclamation-actions {
            display: flex;
            justify-content: space-between;
            margin-bottom: 1.5rem;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            padding: 0.5rem 1rem;
            border: none;
            border-radius: 4px;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .btn i {
            margin-right: 0.5rem;
        }

        .btn-primary {
            background-color: #007bff;
            color: #fff;
        }

        .btn-secondary {
            background-color: #6c757d;
            color: #fff;
        }

        .btn-danger {
            background-color: #dc3545;
            color: #fff;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .reclamation-delete {
            text-align: center;
        }

        .reclamation-delete form {
            display: inline-block;
        }

        @media (max-width: 600px) {
            .reclamation-actions {
                flex-direction: column;
                gap: 1rem;
            }

            .btn {
                width: 100%;
            }
        }
    </style>
{% endblock %}

