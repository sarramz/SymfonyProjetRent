{% extends 'base.html.twig' %}

{% block title %}Nouvelle Réclamation{% endblock %}

{% block body %}
    <div class="container my-5">
        <h1 class="text-center text-orange fw-bold">Nouvelle Réclamation</h1>

        <form method="post" action="{{ path('app_reclamation_new') }}" class="p-4 bg-light shadow rounded">
            <div class="form-group mb-4">
                <label for="contenu" class="form-label text-black fw-semibold">Contenu de la réclamation</label>
                <textarea id="contenu" name="contenu" placeholder="Votre reclamation ici" class="form-control" rows="5" required></textarea>
            </div>
            <div class="mt-3 text-center">
                <button type="submit" class="btn btn-success px-4">Envoyer</button>
                <a href="{{ path('app_home') }}" class="btn btn-danger px-4">Annuler</a>
            </div>
        </form>
    </div>
{% endblock %}
{% block stylesheets %}

<style>
    body {
        background: white;
        font-family: 'Jost', sans-serif;

    }
    </style>
{% endblock %}
